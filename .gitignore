data/*
!data/ignore_sites.txt
# Permanent word→id map behind the ?w= share URLs. Tracked on purpose: an id has
# to mean the same word forever, so losing this file breaks every shared link.
!data/word_ids.tsv
# Curator marks behind the ★ picks and the „respinse" filter. Tracked on purpose: it is
# the only signal allowed to subtract from the default view, so it has to be reviewable
# as a diff rather than a live read of one person's clicking.
!data/editorial.tsv
# Seed word list for public/sitemap.xml (tools/export_sitemap_words.py). Tracked so the
# sitemap's source is a reviewable diff, same reasoning as editorial.tsv above.
!data/sitemap_words.tsv
/tmp
/data/*
!/data/ignore_sites.txt
!/data/word_ids.tsv
!/data/editorial.tsv
!/data/sitemap_words.tsv
*.code-workspace
*/_obsolete
*/*.log
*.log
*/data/*
_obsolete
*/_obsolete/*
_obsolete*
docs/reference/*
.vscode/*
.claude/*
.github/*
.superpowers/
.mcp.json

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.playwright-mcp
# Server-side user data (accounts, annotations, lists, game results)
/private/
public/api/config.local.php
!public/data/.htaccess
# Generated by tools/build_sitemap.py from data/sitemap_words.tsv + ui.db — a build
# artifact like public/data/ui.db itself, not tracked source. Rebuild before deploy.
/public/sitemap.xml

# Node dev dependencies (tests only)
node_modules/
